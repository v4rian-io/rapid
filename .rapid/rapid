#!/usr/bin/env bash
# rapid - software development lifecycle tool: branches in, one merge out, history as the database.
#
# Usage:
#   rapid setup                          activate hooks, seed main and dev; the human runner is the first admin
#   rapid setup --require-test          the first setup writes requirement_test=required: every branch states
#                                      its requirement and its test (later: a [MODE] change of .rapid/conf)
#   rapid branch <kind> <name> [-r TEXT] [--test PATH] [--ticket ID]
#                                      start pool/v<series>/n<N>.<kind>.<name> at dev (n<N>: its number, creation
#                                      ordered, never shared, online or offline); .rapid/requirements/<name>.md is
#                                      written when -r, --test or --ticket states something, always under
#                                      requirement_test=required
#                                      (--test: the test file or scenario name that verifies it, as its Test: line);
#                                      it also writes the safety anchor safety/v<series>/n<N>.<kind>.<name> (kept forever)
#   rapid status [--json]                where you are, open branches, last version
#   rapid -h | --help
#
# kinds: feature fix r&d refactor docs test. names: a-z, 0-9 and -, 2 to 48 chars.
# Policy, gates and limits live in .rapid/conf (see lib/policy.sh); land always
# applies the conf committed on dev, never the branch's own copy.
# main is production: publishing is a release reaching main, and by default only
# the owner, an admin listed in .rapid/admins, promotes dev to main (rapid release;
# release_who=list with release_list names others). dev is
# integration: rapid land --batch lands into the open batch and defers its
# close, rapid land closes the batch; pushing dev, branches or tags to a
# remote is transport, never publishing.
#
# Exit codes: 0 done, 1 refused or failed (the reason is printed), 2 usage,
# 3 land --pr is waiting for approvals, or the forge has not accepted a release merge yet,
# 4 land met a conflict rebasing the branch onto dev (the branch is left as it was).
set -euo pipefail

# rapid may run through a link (rapid setup --install): its libraries stand beside the file itself
_rs="${BASH_SOURCE[0]}"
while [ -L "$_rs" ]; do
  _rl=$(readlink "$_rs"); case "$_rl" in /*) _rs="$_rl" ;; *) _rs="$(dirname "$_rs")/$_rl" ;; esac
done
RAPID_SELF="$(cd "$(dirname "$_rs")" && pwd)"; unset _rs _rl
# installed mode (lib/pin.sh): a repository that pins another version of rapid is served by it
if [ -f "$RAPID_SELF/lib/pin.sh" ]; then
  # shellcheck source=/dev/null
  . "$RAPID_SELF/lib/pin.sh"
  case "${1:-}" in
    -h|--help|"") ;;
    # the installed rapid moves the pin itself: the pinned version may predate the verb
    upgrade) ;;
  esac
fi
# a land is checked by dev's framework, never by the branch's own copy (lib/devexec.sh)
if [ "${1:-}" = land ]; then
  . "$RAPID_SELF/lib/devexec.sh"; rapid_devexec "$RAPID_SELF" rapid "$@"
fi
# shellcheck source=/dev/null
. "$RAPID_SELF/lib/core.sh"
for _l in "$RAPID_SELF"/lib/*.sh; do
  # the core is loaded; devexec is a program of its own
  case "${_l##*/}" in core.sh|devexec.sh) continue ;; esac
  # shellcheck source=/dev/null
  . "$_l"
done
unset _l

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit "${1:-0}"; }
# usage_verb VERB: the usage lines of one verb (and their continuations).
usage_verb() {
  awk -v v="$1" 'NR > 1 && /^#/ { sub(/^# ?/, "")
      if ($0 ~ "^  rapid " v "( |$)") { on = 1; print; next }
      if (on && $0 ~ /^   +[^ ]/ && $0 !~ /^  rapid /) { print; next }
      on = 0; next }
    NR > 1 { exit }' "$0"
  exit 0
}

# _setup_first: 0 at the first setup of a repository: it has no commit, or it has commits but
# no seed (no committed .rapid/ and no dev here or on origin), which the seed commit then
# goes on top of.
_setup_first() {
  git rev-parse -q --verify HEAD >/dev/null || return 0
  ! git cat-file -e HEAD:.rapid 2>/dev/null && ! git rev-parse -q --verify refs/heads/dev >/dev/null \
    && ! git rev-parse -q --verify refs/remotes/origin/dev >/dev/null
}

# _setup_conf_write: the conf of the first setup, before the seed commit takes it. A
# repository with no .rapid/conf gets one that says gates_full=none out loud (a land
# refuses an unset gates_full), so the defaults land; rapid setup --require-test adds
# requirement_test=required. Only the first setup writes: in a seeded repository the
# conf changes by an admin's [MODE] commit.
_setup_conf_write() {
  if ! _setup_first; then
    [ "${_setup_reqtest:-0}" = 0 ] \
      || rapid_die "setup --require-test sets requirement_test at the first setup only; this repository is seeded, so an admin lands requirement_test=required in a [MODE] commit of .rapid/conf"
    return 0
  fi
  if [ ! -f .rapid/conf ]; then
    printf '# .rapid/conf: one key=value per line (MANUAL.md, section 3).\n# No gate is set yet: name your test command here, one shell command, exit 0 passes.\ngates_full=none\n' > .rapid/conf
    rapid_info "conf: .rapid/conf written with gates_full=none (no gate runs until you name one there)"
  fi
  [ "${_setup_reqtest:-0}" = 1 ] || return 0
  local have; have=$(RAPID_CONF_REV="" rapid_conf requirement_test "")
  case "$have" in
    required) ;;
    "") printf 'requirement_test=required\n' >> .rapid/conf; rapid_info "conf: requirement_test=required (every branch states its requirement and its test)" ;;
    *) rapid_die "setup --require-test: .rapid/conf already sets requirement_test=$have; change that line" ;;
  esac
}

cmd_setup() {
  case "${1:-}" in
    "") ;;
    *) RAPID_RC=2 rapid_die "setup: unknown argument $1" ;;
  esac
  local root email tree root_c
  root=$(rapid_root); cd "$root"
  # the admins are this working copy's own configuration: excluded by default (an admin may commit them)
  # the framework's own repository (it holds .rapid/rapid) is seeded before its own branches
  # bring the files its gates name; anywhere else a gate naming a missing file is refused
  local miss=""; [ -f .rapid/rapid ] || miss=$(RAPID_CONF_REV="" rapid_gate_missing "$root")
  if [ -n "$miss" ]; then
    printf '%s\n' "$miss" | sed 's/^/  /' >&2
    rapid_die "set your own gates in .rapid/conf first (gates_fast, gates_full, gates_release: one shell command each, exit 0 passes; gates_full=none lands without a full gate)"
  fi
  email=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/.*<([^>]*)>.*/\1/') || email=""
  local uname; uname=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/^(.*) <[^>]*>.*$/\1/') || uname=""
  _setup_conf_write
  # main is production and the admins alone promote dev to main and flip policy: every
  # setup of a working copy that names no admin yet names the setup author (never an
  # agent), from git's user.email and user.name; the file stays in this working copy only
  if [ ! -f .rapid/admins ]; then
    if RAPID_CONF_REV="" rapid_agent_session >/dev/null; then
      rapid_warn "the setup author is an agent, so no admin is written; rapid setup --owner EMAIL names the owner"
    else
      printf '# Admins: one email per line. They alone change .rapid/conf, in [MODE] commits, and release. This file stays in this working copy unless an admin commits it.\n%s\n' "$email${uname:+ # $uname}" > .rapid/admins
      rapid_info "admin: $email${uname:+ ($uname)} (the admins flip policy in [MODE] commits and promote dev to main)"
    fi
  fi
  if _setup_first; then
    local par=() ix
    if git rev-parse -q --verify HEAD >/dev/null; then
      # a repository with commits: they stay main (where main is missing, main is HEAD), and the
      # seed is their child on dev, the .rapid directory added to HEAD's tree
      ix=$(rapid_tmpdir seed)
      GIT_INDEX_FILE="$ix/index" git read-tree HEAD
      GIT_INDEX_FILE="$ix/index" git add -- .rapid
      tree=$(GIT_INDEX_FILE="$ix/index" git write-tree); rm -rf "$ix"; par=(-p HEAD)
    else
      git add -- .rapid
      tree=$(git write-tree)
    fi
    root_c=$(printf '[NEW] Seed the rapid workflow\n\nRoot commit: the .rapid directory as it stands, before any branch.\n' | git commit-tree "$tree" ${par[@]+"${par[@]}"})
    if [ ${#par[@]} = 0 ]; then
      git update-ref refs/heads/main "$root_c"
      git symbolic-ref HEAD refs/heads/main
      git reset -q
      rapid_info "seeded main at $(git rev-parse --short "$root_c")"
    else
      git rev-parse -q --verify refs/heads/main >/dev/null || git branch main HEAD
      git update-ref refs/heads/dev "$root_c"
      git symbolic-ref HEAD refs/heads/dev
      git reset -q
      rapid_info "seeded dev at $(git rev-parse --short "$root_c")"
    fi
  fi
  if ! git rev-parse -q --verify refs/heads/main >/dev/null; then
    # a clone that checked out another branch holds no main of its own: it is the main of origin
    # with no main anywhere it is the seed of dev: main holds the seed or a release merge, never a tip of dev
    if git rev-parse -q --verify refs/remotes/origin/main >/dev/null; then git branch -q main refs/remotes/origin/main
    elif git rev-parse -q --verify refs/heads/dev >/dev/null; then git branch main "$(rapid_dev_root refs/heads/dev)"
    else git branch main HEAD; fi
  fi
  if ! git rev-parse -q --verify refs/heads/dev >/dev/null; then
    # a clone that checked out main holds no dev of its own: it is the dev of origin
    if git rev-parse -q --verify refs/remotes/origin/dev >/dev/null; then git branch -q dev refs/remotes/origin/dev
    else
      git branch dev main
      rapid_info "created dev at main"
    fi
  fi
  if rapid_has_remote; then
    local need=""
    git ls-remote --exit-code origin refs/heads/main >/dev/null 2>&1 || need="$need main"
    git ls-remote --exit-code origin refs/heads/dev >/dev/null 2>&1 || need="$need dev"
    if [ -n "$need" ]; then
      # Seeding never advances main: main goes up only where it is. When dev
      # goes up it carries every tag it holds, so pre-push sees each merge
      # with its tag (an existing history seeds in one atomic push).
      local tags="" t
      if [[ " $need " == *" dev "* ]]; then
        for t in $(git tag --merged dev); do
          tags="$tags refs/tags/$t:refs/tags/$t"
        done
      fi
      # shellcheck disable=SC2086
      # the gate log goes with dev: a deferred test record is shown by the close record it holds
      if [[ " $need " == *" dev "* ]] && git rev-parse -q --verify refs/notes/gates >/dev/null; then tags="$tags refs/notes/gates:refs/notes/gates"; fi
      # shellcheck disable=SC2086
      git push -q --atomic origin $need $tags || rapid_die "origin refused the push; nothing was published"
      rapid_info "seeded origin with:$need${tags:+ plus the tags on dev}"
    fi
  fi
}

# ---------------------------------------------------------------- branch
_slug_taken() {
  local slug="$1" ns="$RAPID_POOL_NS"
  git log --first-parent --format=%s dev 2>/dev/null | grep -E "^\[MERGE\] pool/[^ ]*[.]$slug into dev: " >/dev/null && return 0
  rapid_has_remote && ns="$ns refs/remotes/origin/pool"
  # shellcheck disable=SC2086
  git for-each-ref --format='%(refname)' $ns | sed -E "s#.*/##; s/^$RAPID_NUM_RE[.]//; s/^[a-z]+[.]//" | grep -Fx -- "$slug" >/dev/null && return 0
  return 1
}

# _number_max: the highest N this clone knows of (lib/core.sh, branch numbers):
# the Branch-Number of dev's merges, every safety anchor (this clone's and
# origin's as last fetched) and every branch name; never below the count of
# merges on dev, since each branch landed before numbers spent one.
_number_max() {
  local m c
  m=$( { git log --first-parent --format='%(trailers:key=Branch-Number,valueonly)' dev 2>/dev/null || true
         git for-each-ref --format='%(refname)' refs/heads/safety refs/rapid/origin-safety $RAPID_POOL_NS \
           refs/remotes/origin/pool | sed 's#.*/##'
       } | sed -nE 's/^n([0-9]+)([.].*)?$/\1/p' | sort -n | tail -n 1)
  c=$(git rev-list --first-parent --merges --count dev 2>/dev/null || echo 0)
  if [ -n "$m" ] && [ "$m" -ge "$c" ]; then printf '%s' "$m"; else printf '%s' "$c"; fi
}

# _number_take KIND NAME FORK [ANCHOR]: take the next branch number and print
# it. Without ANCHOR a new branch's anchor <kind>/<number>.<name> is written at
# FORK: the anchor carries the number. With ANCHOR (the anchor of a branch made
# by hand, whose name carries no number) nothing is written: the number goes
# into the merge of the land that asks for it. Nothing is pushed here: opening
# a branch never reaches origin. The anchors origin holds are counted when it
# answers; counting and writing the anchor are one step for the work trees of
# this clone, so two of them never share a number.
_number_take() {
  local kind="$1" slug="$2" fork="$3" have="${4:-}" n num obj name lock tries=0
  if rapid_has_remote && [ "$RAPID_OFFLINE" != 1 ]; then
    git fetch -q --no-tags origin '+refs/heads/safety/*:refs/rapid/origin-safety/*' 2>/dev/null || true
  fi
  lock="$(git rev-parse --git-common-dir)/rapid/number.lock"; mkdir -p "${lock%/*}"
  # the lock is a file holding this pid, made in one step (noclobber); a holder that is gone is lifted
  until ( set -C; printf '%s\n' "$$" > "$lock" ) 2>/dev/null; do
    rapid_lock_lift "$lock" "rapid branch" && continue
    tries=$((tries + 1)); [ "$tries" -le 20 ] || rapid_die "could not reserve a branch number in 20 tries; run rapid branch again"
    sleep 1
  done
  n=$(( $(_number_max) + 1 )); num="n$n"
  if [ -z "$have" ]; then
    name=$(rapid_branch_name "$kind" "$slug" "$num" "${RAPID_POOL_SERIES:-}"); name="${name#pool/}"
    obj=$(rapid_anchor_commit "$name" "$fork")
    git update-ref "refs/heads/safety/$name" "$obj" "$RAPID_ZERO" || { rm -f "$lock"; rapid_die "could not write the anchor safety/$name"; }
  fi
  rm -f "$lock"
  printf '%s' "$num"
}

# _branch_renumber_taken BRANCH KIND NAME: a number is taken in the clone when its branch
# opens (nothing is pushed), so another clone may publish the same number first.
# When origin holds a safety anchor that carries BRANCH's number for another branch,
# BRANCH, never pushed, takes the next free number here: its branch and its anchor
# move to the new name. Prints the branch's name, new or unchanged. rapid sync and
# rapid land call it; the close refuses a number that is taken after the land.
_branch_renumber_taken() {
  local branch="$1" kind="$2" slug="$3" num own theirs fork nn new ser oan
  num=$(rapid_branch_number "$branch"); oan=$(rapid_anchor_ref "$branch")
  own=""; [ -z "$num" ] || own=$(git rev-parse -q --verify "$oan" || true)
  if [ -z "$own" ] || ! rapid_has_remote; then printf '%s' "$branch"; return 0; fi
  # an anchor of origin with this number, another name, another anchor commit: another branch
  # (a renamed branch keeps its anchor commit under the new name)
  theirs=$(git ls-remote origin "refs/heads/safety/*/$num.*" 2>/dev/null | awk -v a="$oan" -v o="$own" '$2 != a && $1 != o { print $2; exit }' || true)
  if [ -z "$theirs" ]; then printf '%s' "$branch"; return 0; fi
  fork=$(git rev-parse -q --verify "$oan^1" || git merge-base dev "$branch")
  ser=$(printf '%s' "$branch" | cut -d/ -f2)
  # this clone's anchor under the number was never published: it goes, the branch counts again
  nn=$(RAPID_POOL_SERIES="$ser" _number_take "$kind" "$slug" "$fork")
  new="pool/$ser/$nn.$kind.$slug"
  git branch -m "$branch" "$new"
  git update-ref -d "$oan" 2>/dev/null || true
  rapid_info "branch number $num was published by another clone first; $branch is now $new" >&2
  printf '%s' "$new"
}

# _branch_number_of BRANCH: the number BRANCH's name carries, checked to be this branch's
# alone: no other safety anchor carries it, no merge of dev landed another branch under
# it. Empty for a branch whose name carries none (made by hand): its land takes one.
_branch_number_of() {
  local branch="$1" num an o other
  an=$(rapid_anchor_ref "$branch")
  num=$(rapid_branch_number "$branch")
  [ -n "$num" ] || return 0
  rapid_anchor_make "$branch" "$(git merge-base dev "$branch" 2>/dev/null || git rev-parse "$branch")" >/dev/null
  o=$(git rev-parse -q --verify "$an" || true)
  other=$(git for-each-ref --format='%(objectname) %(refname)' refs/heads/safety refs/rapid/origin-safety \
    | awk -v o="$o" -v n="$num." '{ b = $2; sub(/.*\//, "", b) } index(b, n) == 1 && $1 != o { print b; exit }')
  [ -n "$other" ] || other=$(git log --first-parent --format='%(trailers:key=Branch-Number,valueonly,separator=%x2C)%x09%s' dev 2>/dev/null \
    | awk -F '\t' -v n="$num" -v b="$branch" '$1 == n && index($2, "[MERGE] " b " into dev: ") != 1 { split($2, w, " "); sub(/^.*\//, "", w[2]); print w[2]; exit }')
  [ -z "$other" ] || rapid_die "$num belongs to another branch ($other); branch numbers are never shared (I7)"
  printf '%s' "$num"
}

cmd_branch() {
  case "${1:-}" in
    ""|-h|--help) usage 2 ;;
  esac
  local kind="$1" slug="${2:-}" req="" ticket="" req_test="" root
  shift 2 || usage 2
  while [ $# -gt 0 ]; do
    case "$1" in
      -r) req="${2:-}"; shift 2 ;;
      --ticket) ticket="${2:-}"; shift 2 ;;
      --test) req_test="${2:-}"; [ -n "$req_test" ] || RAPID_RC=2 rapid_die "branch: --test needs a test file or scenario name"; shift 2 ;;
      *) RAPID_RC=2 rapid_die "branch: unknown argument $1" ;;
    esac
  done
  rapid_kind_ok "$kind" || RAPID_RC=2 rapid_die "kind '$kind' is not one of: $RAPID_KINDS"
  rapid_slug_ok "$slug" || RAPID_RC=2 rapid_die "name '$slug' must be a-z, 0-9 and -, 2 to 48 chars"
  root=$(rapid_root); cd "$root"
  git rev-parse -q --verify refs/heads/dev >/dev/null || rapid_die "no dev branch; run 'rapid setup'"
  [ -z "$(git status --porcelain --untracked-files=no)" ] || rapid_die "the work tree has uncommitted changes; commit or stash them first"
  # a work tree that could not follow dev would carry its old files into the branch as staged changes
  [ -z "$(git status --porcelain --untracked-files=no)" ] \
    || rapid_die "dev moved under this work tree and it could not follow (see above); catch it up, then rapid branch again"
  _slug_taken "$slug" && rapid_die "name '$slug' is already used by a branch, landed or not (I7); pick another"
  local tk=""
  if [ -n "$ticket" ]; then
    rapid_tracker >/dev/null   # refuses a misconfigured tracker here, in this shell
    tk=$(rapid_tracker_call get "$ticket" || true)
    [ -n "$req" ] || req=$(rapid_json_str "$tk" title)
  fi
  # the branch's number (creation order, never shared) and its fork point, kept forever
  local num; num=$(_number_take "$kind" "$slug" dev)
  local pn; pn=$(rapid_branch_name "$kind" "$slug" "$num")
  git switch -q -c "$pn" dev
  # the requirement file: always under requirement_test=required; else only when the branch
  # states something (-r, --test, --ticket), so no placeholder stands in the way of a commit
  local rnote="no requirement file (requirement_test=optional; -r states one)"
  if [ "$(rapid_conf requirement_test optional)" = required ] || [ -n "$req" ] || [ -n "$req_test" ] || [ -n "$ticket" ]; then
    mkdir -p "$RAPID_REQ_DIR"
    {
      printf '# %s/%s\n\n' "$kind" "$slug"
      printf '%s\n' "${req:-$RAPID_REQ_PLACEHOLDER}"
      [ -z "$ticket" ] || printf '\nTicket: %s\n' "$ticket"
      [ -z "$req_test" ] || printf '\nTest: %s\n' "$req_test"
    } > "$RAPID_REQ_DIR/$slug.md"
    git add -- "$RAPID_REQ_DIR/$slug.md"
    rnote="$RAPID_REQ_DIR/$slug.md is staged with your first commit"
  fi
  [ -z "$ticket" ] || rapid_tracker_call link "$ticket" --branch "$pn" >/dev/null || true
  rapid_info "$pn started at dev ($(git rev-parse --short dev)), anchored at safety/${pn#pool/}; nothing is pushed; $rnote"
}

# _not_landed: every branch dev does not hold, here or on origin as last
# fetched, one name per line: a branch never landed stays a branch, its anchor
# kept forever, and status and doctor list it.
_not_landed() {
  local r n
  git rev-parse -q --verify refs/heads/dev >/dev/null || return 0
  # shellcheck disable=SC2086
  git for-each-ref --format='%(refname)' $RAPID_POOL_NS refs/remotes/origin/pool | while read -r r; do
    git merge-base --is-ancestor "$r" dev 2>/dev/null && continue
    n="${r#refs/heads/}"; n="${n#refs/remotes/origin/}"; printf '%s\n' "$n"
  done | sort -u
  return 0
}

# _landed_live: origin's branches that dev already holds (landed, not yet deleted),
# one per line; empty without origin or when it is unreachable.
_landed_live() {
  rapid_has_remote || return 0
  local sha ref d
  d=$(git rev-parse -q --verify refs/remotes/origin/dev || git rev-parse -q --verify refs/heads/dev) || return 0
  git ls-remote origin 'refs/heads/pool/*' 2>/dev/null | while read -r sha ref; do
    git cat-file -e "$sha^{commit}" 2>/dev/null && git merge-base --is-ancestor "$sha" "$d" 2>/dev/null && printf '%s\n' "${ref#refs/heads/}"
  done
  return 0
}

# ---------------------------------------------------------------- status
cmd_status() {
  local root b v rel l ahead behind json=false sep="" oa="" ob=""
  case "${1:-}" in --json) json=true ;; "") ;; *) RAPID_RC=2 rapid_die "status: unknown argument $1" ;; esac
  root=$(rapid_root); cd "$root"
  if $json; then
    b=$(rapid_branch); read -r v rel <<<"$(rapid_version_last dev)"
    if rapid_has_remote && git rev-parse -q --verify refs/remotes/origin/dev >/dev/null && git rev-parse -q --verify refs/heads/dev >/dev/null; then
      oa=$(git rev-list --count dev..origin/dev); ob=$(git rev-list --count origin/dev..dev)
    fi
    printf '{"branch": "%s", "dev": "%s", "version": "%s", "released": %s, "origin_ahead": %s, "origin_behind": %s, "branches": [' \
      "$b" "$(git rev-parse dev 2>/dev/null)" "$v" "$([ "$rel" = 1 ] && echo true || echo false)" "${oa:-null}" "${ob:-null}"
    for l in $(git for-each-ref --format='%(refname:short)' $RAPID_POOL_NS); do
      printf '%s{"name": "%s", "ahead": %s, "behind": %s}' "$sep" "$l" "$(git rev-list --count "dev..$l")" "$(git rev-list --count "$l..dev")"; sep=", "
    done
    return 0
  fi
  b=$(rapid_branch)
  local ns; ns=$(_need_setup)
  [ -z "$ns" ] || rapid_info "setup: $ns; run 'rapid setup'"
  read -r v rel <<<"$(rapid_version_last dev)"
  rapid_info "branch: ${b:-detached at $(git rev-parse --short HEAD)}"
  rapid_info "dev: $(git rev-parse --short dev 2>/dev/null || echo none), last version ${v:-none}$([ "$rel" = 1 ] && echo ' (released)')"
  if rapid_has_remote && git rev-parse -q --verify refs/remotes/origin/dev >/dev/null && git rev-parse -q --verify refs/heads/dev >/dev/null; then
    rapid_info "origin/dev: $(git rev-list --count dev..origin/dev) ahead, $(git rev-list --count origin/dev..dev) behind local dev (as last fetched)"
  fi
  rapid_info "open branches:"
  for l in $(git for-each-ref --format='%(refname:short)' $RAPID_POOL_NS); do
    ahead=$(git rev-list --count "dev..$l"); behind=$(git rev-list --count "$l..dev")
    rapid_info "  $l  $ahead commit(s), $behind behind dev$([ "$l" = "$b" ] && echo '  <- here')"
  done
  local ul; ul=$(_not_landed)
  [ -z "$ul" ] || rapid_info "branches not landed yet: $(tr '\n' ' ' <<<"$ul")"
  local ll; ll=$(_landed_live)
  [ -z "$ll" ] || rapid_info "landed, still on origin (an admin deletes them with rapid branch --delete-landed): $(tr '\n' ' ' <<<"$ll")"
}

# A clone that never ran rapid setup has no hooks and maybe no dev: the verbs
# that write (branch, commit, land, sync, release) refuse with the one command to run,
# instead of working unguarded or failing with a raw git error. check, bisect
# and doctor stay usable without it (the forge workflow runs them on a
# runner that has no hooks); status says what is missing.
_need_setup() {
  local hp; hp=$(git config --get core.hooksPath 2>/dev/null || true)
  git rev-parse -q --verify refs/heads/dev >/dev/null || { echo "this clone has no dev branch"; return 0; }
}

case "${2:-}" in -h|--help) case "${1:-}" in setup|branch|check|commit|land|sync|release|bisect|status|doctor|changelog|version|queue|hook|upgrade) usage_verb "$1" ;; esac ;; esac
case "${1:-}" in
  branch|land|sync|release|commit|upgrade)
    if git rev-parse --git-dir >/dev/null 2>&1; then
      _ns=$(cd "$(rapid_root)" && _need_setup)
      [ -z "$_ns" ] || rapid_die "$_ns; run 'rapid setup' first (.rapid/rapid setup)"
    fi ;;
esac
case "${1:-}" in
  setup) shift; cmd_setup "$@" ;;
  branch) shift; cmd_branch "$@" ;;
  status) shift; cmd_status "$@" ;;
  -h|--help) usage 0 ;;
  *) usage 2 ;;
esac
